# Скопіюйте в .env і за потреби змініть. .env у .gitignore — секрети не потрапляють у git.
COLLECTOR_DB=data/collector.db
TARGETS_FILE=targets.toml
LOG_LEVEL=INFO

# Ввічливість: пауза між запитами до одного хоста, спроби, стеля очікування на Retry-After
REQUEST_DELAY=1.5
MAX_RETRIES=4
MAX_WAIT=300
MAX_PAGES_PER_RUN=5
USER_AGENT=study-osint-collector/0.1 (OSINT course homework; contact: you@example.com)

# Необовʼязково: власні токени застосунку (Preferences → Development, scope read:statuses).
# Формат host=token через кому; кілька токенів одного хоста ротуються, 429 охолоджує лише свій ключ.
MASTODON_TOKENS=

# Необовʼязково: проксі-вихід, напр. socks5://127.0.0.1:9050 або http://host:port.
# У Docker 127.0.0.1 — це сам контейнер; проксі хоста: socks5://host.docker.internal:9050
COLLECTOR_PROXY=
